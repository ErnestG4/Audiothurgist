#!/usr/bin/env bash
# tools/web/fetch URL [--raw] [--js] [--max N]
#   default: fetch with curl, extract the readable text (trafilatura); fall back to headless Chromium
#   when the page comes back empty (JavaScript-rendered). --js forces Chromium; --raw prints the HTML.
#   --max N caps the output at N characters (default 40000). Agents: use instead of WebFetch.
cd "$(dirname "$0")"
exec .venv/bin/python - "$@" <<'PY'
import sys, subprocess
args = sys.argv[1:]; url = args[0]; raw = '--raw' in args; js = '--js' in args
mx = int(args[args.index('--max') + 1]) if '--max' in args else 40000
UA = 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36'
def curl(u):
    try: return subprocess.run(['curl', '-sL', '-A', UA, '--max-time', '30', u], capture_output=True, text=True, errors='replace').stdout
    except Exception: return ''
def chromium(u):
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        b = p.chromium.launch(); pg = b.new_page(user_agent=UA)
        pg.goto(u, wait_until='networkidle', timeout=45000); html = pg.content(); b.close(); return html
import trafilatura
html = chromium(url) if js else curl(url)
text = None if raw else trafilatura.extract(html, include_links=False, include_tables=True, favor_recall=True)
if not raw and (not text or len(text) < 200) and not js:
    try: html = chromium(url); text = trafilatura.extract(html, include_links=False, include_tables=True, favor_recall=True)
    except Exception as e: text = (text or '') + f"\n[chromium fallback failed: {e}]"
out = html if raw else (text or '[no readable text]')
print(out[:mx]); 
if len(out) > mx: print(f"\n[truncated at {mx} of {len(out)} chars; use --max]")
PY
